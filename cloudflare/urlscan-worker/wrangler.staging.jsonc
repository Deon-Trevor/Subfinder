{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subfinder-urlscan-stage",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "r2_buckets": [
    { "binding": "CATALOG", "bucket_name": "subfinder-catalog-stage" }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL",
      "database_name": "subfinder-urlscan-stage-control",
      "database_id": "a9bbd2ab-1158-4097-980b-28f74da6b792",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "URLSCAN_QUEUE", "queue": "subfinder-urlscan-stage" },
      { "binding": "COMPACTION_QUEUE", "queue": "subfinder-compaction-stage" }
    ],
    "consumers": [
      {
        "queue": "subfinder-urlscan-stage",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "subfinder-urlscan-stage-dead",
        "max_concurrency": 1
      }
    ]
  },
  "vars": {
    "URLSCAN_BREADTH_DAILY_LIMIT": "25",
    "URLSCAN_PAGE_SIZE": "100",
    "URLSCAN_REFRESH_SECONDS": "86400",
    "URLSCAN_SOURCE_LIMIT": "1"
  }
}
