{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subfinder",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "assets": {
    "directory": "../../web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/v1/*",
      "/health",
      "/ready",
      "/mcp",
      "/internal/*",
      "/docs",
      "/docs/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "CATALOG",
      "bucket_name": "subfinder-catalog-stage"
    }
  ],
  "services": [
    { "binding": "URLSCAN_INGEST", "service": "subfinder-urlscan-stage" }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA_LEDGER",
        "class_name": "QuotaLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-quota-ledger",
      "new_sqlite_classes": ["QuotaLedger"]
    }
  ],
  "vars": {
    "BATCH_MAX_APEXES": "100",
    "BATCH_MAX_RECORDS": "5000",
    "QUEUED_BATCH_MAX_APEXES": "25000",
    "QUEUED_BATCH_MAX_PENDING": "128",
    "QUEUED_BATCH_MAX_PENDING_PER_TOKEN": "16",
    "CATALOG_ROOT_KEY": "catalog/root.json",
    "DOCS_ORIGIN": "https://subfinder-docs.pages.dev",
    "MCP_ALLOWED_HOSTS": "subfinder.pundit.workers.dev",
    "MCP_RESULT_LIMIT": "100000",
    "PUBLIC_REQUEST_LIMIT": "1000",
    "TOKEN_REQUEST_LIMIT": "250000"
  }
}
