{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subfinder-index-spike",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "../../web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/v1/*",
      "/health",
      "/ready",
      "/mcp",
      "/internal/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "CATALOG",
      "bucket_name": "subfinder-index-spike"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "QUOTA_LEDGER",
        "class_name": "QuotaLedger"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-quota-ledger",
      "new_sqlite_classes": ["QuotaLedger"]
    }
  ],
  "vars": {
    "BATCH_MAX_APEXES": "100",
    "BATCH_MAX_RECORDS": "5000",
    "CATALOG_ROOT_KEY": "catalog/root.json",
    "MCP_RESULT_LIMIT": "100000",
    "PUBLIC_REQUEST_LIMIT": "1000",
    "TOKEN_REQUEST_LIMIT": "250000"
  }
}
