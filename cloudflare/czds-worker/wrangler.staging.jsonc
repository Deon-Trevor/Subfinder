{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subfinder-czds-stage",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "limits": { "cpu_ms": 120000 },
  "triggers": { "crons": [] },
  "containers": [
    { "class_name": "CzdsParser", "image": "../Dockerfile.czds",
      "max_instances": 2, "instance_type": "standard-2" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CZDS_PARSER", "class_name": "CzdsParser" }]
  },
  "migrations": [
    { "tag": "v1-czds-parser", "new_sqlite_classes": ["CzdsParser"] }
  ],
  "r2_buckets": [
    { "binding": "CATALOG", "bucket_name": "subfinder-catalog-stage" }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL",
      "database_name": "subfinder-czds-stage-control",
      "database_id": "57aecc4f-970a-4327-a8e2-f525445becdc",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "COMPACTION_QUEUE", "queue": "subfinder-compaction-stage" }
    ]
  },
  "workflows": [
    {
      "name": "subfinder-czds-ingestion-stage",
      "binding": "CZDS_WORKFLOW",
      "class_name": "CzdsIngestionWorkflow"
    }
  ],
  "vars": {
    "CZDS_ONLY_ZONE": "info",
    "CZDS_CONTAINER_ZONES": "com,biz,net,org,xyz,top,info,shop,online,store,vip,site,app,bond,pro",
    "CZDS_STAGE_ONLY": "true",
    "CZDS_DELTA_RECORDS": "20000",
    "CZDS_MAX_ZONES": "1",
    "CZDS_REFRESH_SECONDS": "86400"
  }
}
