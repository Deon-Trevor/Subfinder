{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-direct-ct-ingest",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "triggers": { "crons": [] },
  "r2_buckets": [
    {
      "binding": "CATALOG",
      "bucket_name": "example-catalog"
    }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL",
      "database_name": "example-direct-ct-control",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "INGEST_QUEUE", "queue": "example-direct-ct-jobs" },
      { "binding": "COMPACTION_QUEUE", "queue": "example-compaction-jobs" }
    ],
    "consumers": [
      {
        "queue": "example-direct-ct-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "example-direct-ct-dlq"
      }
    ]
  },
  "vars": {
    "CT_ALLOWED_HOSTS": "ct.googleapis.com,ct.cloudflare.com",
    "CT_RANGE_SIZE": "256",
    "CT_SOURCE_LIMIT": "20",
    "CT_LOG_DISCOVERY_ENABLED": "1",
    "CT_DISCOVERED_SOURCE_LIMIT": "2",
    "CT_INITIAL_BACKFILL": "1024",
    "STATIC_CT_ALLOWED_HOSTS": "mon.willow.ct.letsencrypt.org",
    "STATIC_CT_SOURCE_LIMIT": "1",
    "PUBLIC_SOURCES_ENABLED": "1"
  }
}
