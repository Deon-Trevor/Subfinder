{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subfinder-direct-ct-stage",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "r2_buckets": [
    { "binding": "CATALOG", "bucket_name": "subfinder-catalog-stage" }
  ],
  "d1_databases": [
    {
      "binding": "CONTROL",
      "database_name": "subfinder-ct-stage-control",
      "database_id": "16c2da82-1c0d-455a-9e3b-f1e78cf3c3f4",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "INGEST_QUEUE", "queue": "subfinder-direct-ct-stage" },
      { "binding": "COMPACTION_QUEUE", "queue": "subfinder-compaction-stage" }
    ],
    "consumers": [
      {
        "queue": "subfinder-direct-ct-stage",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "subfinder-direct-ct-stage-dead",
        "max_concurrency": 1
      }
    ]
  },
  "vars": {
    "CT_ALLOWED_HOSTS": "ct.googleapis.com,ct.cloudflare.com",
    "CT_RANGE_SIZE": "16",
    "CT_SOURCE_LIMIT": "1"
  }
}
