{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subfinder-compaction-stage",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 300000 },
  "triggers": { "crons": [] },
  "r2_buckets": [
    { "binding": "CATALOG", "bucket_name": "subfinder-catalog-stage" }
  ],
  "d1_databases": [
    {
      "binding": "LEDGER",
      "database_name": "subfinder-generation-stage-ledger",
      "database_id": "f195a017-ef05-405b-9c9d-09919d5a3bc8",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "COMPACTION_QUEUE", "queue": "subfinder-compaction-stage" }
    ],
    "consumers": []
  },
  "vars": {
    "GENERATION_DELTA_LIMIT": "500",
    "MAX_DELTA_BYTES": "33554432",
    "MAX_REDUCE_RECORDS": "200000",
    "PARTITION_NIBBLES": "2"
  }
}
