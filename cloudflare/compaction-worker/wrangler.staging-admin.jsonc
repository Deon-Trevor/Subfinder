{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subfinder-compaction-stage-admin-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-09-27",
  "workers_dev": false,
  "preview_urls": false,
  "r2_buckets": [
    { "binding": "CATALOG", "bucket_name": "subfinder-catalog-stage", "remote": true }
  ],
  "d1_databases": [
    {
      "binding": "LEDGER",
      "database_name": "subfinder-generation-stage-ledger",
      "database_id": "f195a017-ef05-405b-9c9d-09919d5a3bc8",
      "remote": true
    }
  ],
  "queues": {
    "producers": [
      { "binding": "COMPACTION_QUEUE", "queue": "subfinder-compaction-stage", "remote": false }
    ]
  },
  "vars": {
    "REGISTRATION_ONLY": "false",
    "GENERATION_DELTA_LIMIT": "500",
    "MAX_DELTA_BYTES": "33554432",
    "MAX_REDUCE_RECORDS": "200000",
    "PARTITION_NIBBLES": "2"
  }
}
