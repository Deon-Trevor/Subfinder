# Copy this file to .env and keep it untracked. Compose uses it both for
# explicit service settings and provider credentials. Wrap any value containing
# `$` in single quotes so Compose treats it literally without logging fragments.

# Account-backed ingestion credentials. These are injected only into the jobs
# and scheduler services; the public API does not receive them.
URLSCAN_API_KEY=
CZDS_USERNAME=
CZDS_PASSWORD=

# Scheduled passive-ingestion policy and provider request budgets.
CTLOGS_URLSCAN_APEXES=*
CTLOGS_URLSCAN_DAILY_LIMIT=100000
CTLOGS_URLSCAN_SEARCH_DAILY_LIMIT=10000
CTLOGS_URLSCAN_PRIORITY_DAILY_LIMIT=20000
CTLOGS_SCHEDULED_ARTIFACTS=[]

# Private service API authentication. CTLOGS_API_TOKENS is a comma-separated
# accepted-token list. Threat Hunter's SUBFINDER_API_TOKEN must match one item.
CTLOGS_API_TOKENS=
CTLOGS_TOKEN_REQUEST_LIMIT=10000

# Public and trusted-service admission limits.
CTLOGS_PUBLIC_INFLIGHT_LIMIT=80
CTLOGS_SERVICE_INFLIGHT_LIMIT=16
CTLOGS_BATCH_MAX_APEXES=100
CTLOGS_BATCH_MAX_RECORDS=5000
CTLOGS_QUEUED_BATCH_MAX_APEXES=1000
CTLOGS_QUEUED_BATCH_MAX_PENDING=128
CTLOGS_QUEUED_BATCH_MAX_PENDING_PER_TOKEN=16
CTLOGS_BATCH_WORKER_SLICE_APEXES=25
CTLOGS_BATCH_MAX_SOURCE_ROWS=20000
CTLOGS_BATCH_MAX_DOCUMENT_BYTES=2097152
CTLOGS_BATCH_LEASE_SECONDS=60
CTLOGS_CATALOG_CONCURRENCY=1
CTLOGS_CONTROL_BATCH_WINDOW_SECONDS=0.002

# Deployment networking. Pin this to the exact trusted proxy peer or subnet;
# do not use `*` in production unless every network peer is trusted.
# Set this to the exact socket peer used by NGINX to reach the container.
CTLOGS_FORWARDED_ALLOW_IPS=127.0.0.1
CTLOGS_DATA_VOLUME=subfinder_ctlogs-data
CTLOGS_CONTROL_VOLUME=subfinder_ctlogs-control
CTLOGS_DATA_NETWORK=syncpundit-data-plane
